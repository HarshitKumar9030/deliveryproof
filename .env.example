PORT=3001
# Local single-workspace analysis access. npm run setup:local generates these in .env.local.
WORKSPACE_PASSWORD=
WORKSPACE_SESSION_SECRET=
# Optional exact public origin when deployed behind a proxy, e.g. https://your-app.example
APP_ORIGIN=
# Sandbox only. Obtain these from your PayPal developer app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=deliveryproof-evidence
GEMINI_API_KEY=
# Choose an available Gemini model supporting structured JSON output.
GEMINI_MODEL=
EVIDENCE_STORAGE_DIR=.data/evidence
